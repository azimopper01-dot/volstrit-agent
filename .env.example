# ===== TELEGRAM =====
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_id_here
CHANNEL_ID=@VolstritStart
CHANNEL_LINK=https://t.me/VolstritStart

# Telegram kutish vaqtlari (soniya). Past qiymat "Request timeout" beradi.
TELEGRAM_CONNECT_TIMEOUT=30
TELEGRAM_READ_TIMEOUT=60
TELEGRAM_SEND_RETRIES=4

# ===== AI (GEMINI) =====
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT=120
GEMINI_MAX_OUTPUT_TOKENS=1000

# Google free-tier: 5 so'rov/daqiqa, 20 so'rov/kun.
# Biz chegara chegarasiga tegmaslik uchun pastroq qo'yamiz.
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY=5
AI_DAILY_LIMIT=14
AI_MINUTE_LIMIT=4
AI_MAX_RETRY_WAIT=90

# ===== RASMLAR (har postga ilova) =====
# true — har post bilan birga AI tomonidan rasm yaratiladi.
#       Rasm yaratilmasa ham post RASMSIZ chiqadi (hech qachon to'xtamaydi).
IMAGE_ENABLED=true
# mavjud modellar: gemini-2.5-flash-image, gemini-3.1-flash-image, gemini-3-pro-image
IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_QUALITY=1024x1024
IMAGE_TIMEOUT=90
# Rasmlar uchun kunlik kvota (matndan alohida hisoblanadi)
AI_IMAGE_DAILY_LIMIT=8

# ===== KANAL SOZLAMALARI =====
CHANNEL_NAME=Volstrit uchun start
CHANNEL_TOPIC=fond birjasi, forex, kripto, indekslar, aksiyalar
CHANNEL_LANG=uz
CHANNEL_STYLE=sodda_va_tushunarli
AUDIENCE=yangi_va_tajribali

# ===== POST VAQTLARI (TIMEZONE bo'yicha) =====
POST_TIME_MORNING=08:30
POST_TIME_NOON=13:00
POST_TIME_EVENING=18:30
TIMEZONE=Asia/Tashkent

# ===== SO'ROVNOMA =====
POLL_DAY=sunday
POLL_TIME=10:00

# ===== YUBORISH TARTIBI =====
# true  -> post tayyor bo'lgach AVTOMATIK kanalga chiqadi.
#          Admin xabarni ko'rib, "Kanaldan o'chirish" / "Qayta yozish" 
#          tugmalaridan foydalanishi mumkin.
# false -> avval adminga yuboriladi, "Tasdiqlash"dan keyin kanalga chiqadi.
AUTO_PUBLISH=false
NOTIFY_ADMIN=true
MAX_POST_LENGTH=4096

# ===== MA'LUMOTLAR BAZASI =====
# Railway'ga Volume qo'shgan bo'lsangiz (mount path /data):
# DB_PATH=/data/posts.db
# Aks holda konteyner ichida vaqtinchik saqlanadi (har deploy'da yo'qoladi).
DB_PATH=data/posts.db

# ===== XAVFSIZLIK =====
APPROVAL_TIMEOUT_HOURS=2
APPROVAL_REMINDERS=true

# ===== MAHHALLIY ISHLASH =====
# true — bu kompyuterda botni polling bilan ishga tushirishga ruxsat.
# MAHHALLIYDAN ISHLATGANDA TELEGRAM CONFLICT XATOSI chiqmasligi uchun
# Railway ishlayotgan paytda bu qiymat FALSE bo'lishi SHART.
# (Railway'da ushbu qiymatga qarab ahamiyat yo'q — u avtomatik yoqiladi.)
AL_LOCAL_MODE=false
